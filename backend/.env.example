# ==========================================
# iChat Backend Environment Variables
# ==========================================

# Server Port
PORT=3000

# Client Application URL (for CORS and Socket.IO origin)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/iChat?retryWrites=true&w=majority

# Clerk Authentication & User Management
# Obtain from Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
# Clerk Webhook Signing Secret (from Clerk Dashboard -> Webhooks -> Endpoint)
CLERK_WEBHOOK=your_clerk_webhook_signing_secret

# ImageKit CDN & Media Storage (for image & video uploads)
# Obtain from ImageKit Dashboard -> Developer Options -> API Keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_ENDPOINT_URL=https://ik.imagekit.io/<your_id>
